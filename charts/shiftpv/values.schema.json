{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
        "limits": {"type": "object", "additionalProperties": {"type": ["string", "number"]}}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "serviceAccountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"}
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "resources": {"$ref": "#/definitions/resources"}
      }
    }
  },
  "properties": {
    "nodeRPC": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "port"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535, "not": {"enum": [9808]}}
      }
    },
    "global": {
      "type": "object",
      "description": "Reserved for Helm's parent-chart globals; this chart reads none of them"
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "snapshotInterval", "dashboard", "prometheusRule", "serviceMonitor"],
      "properties": {
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535, "not": {"enum": [9808]}},
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "additionalLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "additionalLabels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "snapshotInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval", "scrapeTimeout", "additionalLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*s$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*s$"},
            "additionalLabels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "image"],
      "properties": {
        "replicas": {"type": "integer", "const": 1},
        "logLevel": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "mobility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval", "journalRetention", "webhookPort", "helperImage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "journalRetention": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
        "webhookPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "helperImage": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubeletRootDir", "image"],
      "properties": {
        "kubeletRootDir": {
          "type": "string",
          "pattern": "^/",
          "description": "Host kubelet state root shared by every selected Node Plugin node"
        },
        "logLevel": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/definitions/image"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "helperPod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "timeout"],
      "properties": {
        "image": {"type": "string"},
        "timeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {"type": "string", "minLength": 1},
                "memory": {"type": "string", "minLength": 1}
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {"type": "string", "minLength": 1},
                "memory": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "poolReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval", "staleAfter"],
      "properties": {
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"},
        "staleAfter": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uninstallMode"],
      "properties": {
        "uninstallMode": {
          "type": "string",
          "minLength": 1,
          "description": "helm or argocd; the pre-delete guard rejects any other value with a named error"
        }
      }
    },
    "storageClass": {
      "type": "object",
      "required": ["create", "name", "defaultClass", "reclaimPolicy"],
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "defaultClass": {"type": "boolean"},
        "reclaimPolicy": {"const": "Delete"}
      }
    },
    "retainStorageClass": {
      "type": "object",
      "required": ["create", "name", "defaultClass", "reclaimPolicy"],
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "defaultClass": {"const": false},
        "reclaimPolicy": {"const": "Retain"}
      }
    },
    "additionalStorageClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["create", "name", "defaultClass", "reclaimPolicy", "poolGroup"],
        "additionalProperties": false,
        "properties": {
          "create": {"type": "boolean"},
          "name": {"type": "string", "minLength": 1},
          "defaultClass": {"const": false},
          "reclaimPolicy": {"enum": ["Delete", "Retain"]},
          "poolGroup": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "helper", "node"],
      "properties": {
        "controller": {"$ref": "#/definitions/serviceAccountRef"},
        "helper": {"$ref": "#/definitions/serviceAccountRef"},
        "node": {"$ref": "#/definitions/serviceAccountRef"}
      }
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provisioner", "registrar", "livenessProbe"],
      "properties": {
        "provisioner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "resources": {"$ref": "#/definitions/resources"},
            "retryIntervalStart": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
            "retryIntervalMax": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"}
          }
        },
        "registrar": {"$ref": "#/definitions/sidecar"},
        "livenessProbe": {"$ref": "#/definitions/sidecar"}
      }
    }
  }
}
